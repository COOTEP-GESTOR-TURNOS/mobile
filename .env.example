# IP del computador que corre Docker en la red Wi-Fi (nunca localhost: el teléfono es otro equipo).
# En el emulador de Android hasta la versión 16 sirve http://10.0.2.2:3000; en Android 17 esa
# dirección queda bloqueada para la app (red local sin permiso): use también la IP del computador.
EXPO_PUBLIC_API_URL=http://192.168.1.50:3000
