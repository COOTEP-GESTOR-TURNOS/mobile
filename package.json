{
  "name": "movil",
  "version": "1.0.0",
  "description": "App móvil de COOTEP Turno (React Native con Expo, APK para Android)",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "apk": "eas build -p android --profile preview"
  },
  "dependencies": {
    "expo": "~58.0.25",
    "expo-build-properties": "~58.0.12",
    "expo-crypto": "~58.0.8",
    "expo-secure-store": "~58.0.3",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "expo-web-browser": "~58.0.8",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
